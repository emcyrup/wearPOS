# ---- Database (PostgreSQL) ----
# ローカル: docker compose up -d で起動する Postgres
DATABASE_URL="postgresql://wearpos:wearpos@localhost:5432/wearpos"
# Neon などのサーバーレス環境では、プール付き (-pooler) の接続文字列を指定する
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# マイグレーション専用の接続先。プールを介さない直結の接続文字列を指定する。
# 未設定なら DATABASE_URL が使われる (ローカルの Postgres では設定不要)
# DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# 1インスタンスあたりの最大接続数 (省略時は 5)
# DATABASE_POOL_MAX="5"

# ---- POS 連携 API ----
# 外部 POS レジから取引を送信する際に X-API-Key ヘッダで渡す共有シークレット
POS_API_KEY="change-me-pos-api-key"

# ---- ログイン (認証) ----
# セッション署名用のシークレット。本番では必ずランダムな値を設定する (openssl rand -base64 32)
# 未設定の場合は POS_API_KEY から導出される
# AUTH_SECRET=""
# "1" にするとログイン不要になる (静的デモ生成・ローカル確認用。本番では使わない)
# AUTH_DISABLED=""

# ---- LINE 自動リマインド ----
# /api/reminders/run の認証キー (Vercel Cron が Authorization: Bearer で送る)
# 未設定でも X-API-Key: POS_API_KEY で手動実行できる
# CRON_SECRET=""

# ---- AI考察 (Claude × Gemini 討論) ----
# ダッシュボードの AI考察に使う Anthropic API キー。未設定でも他の機能は動作する
# ANTHROPIC_API_KEY=""
# 討論相手の Gemini の API キー (https://aistudio.google.com/ で取得)。
# 未設定なら Claude 単独の考察になる
# GEMINI_API_KEY=""
# 使用する Gemini モデル (省略時は gemini-2.5-flash)
# GEMINI_MODEL=""

# ---- LINE 公式アカウント連携 (Messaging API) ----
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
# LINE への自動プッシュ通知を有効にするか
LINE_PUSH_ENABLED="true"

# ---- LIFF (リッチメニューからの直接画面遷移) ----
# LINE Developers で LIFF アプリを作成し、エンドポイント URL に https://<アプリ>/liff を設定する
# 未設定の場合、リッチメニューはキーワード送信方式で動く
# LIFF_ID=""            # 例: 1234567890-abcdefgh
# LIFF_CHANNEL_ID=""    # LIFF アプリが属するチャネルのチャネルID (IDトークン検証に使用)
