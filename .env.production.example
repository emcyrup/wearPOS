# =============================================================================
# 本番サーバー (wearpos.ai-labo.cloud / EC2 自己ホスト) 用の .env 雛形
#
#   cp .env.production.example .env  してから値を埋める。
#   .env は git に入らない (.gitignore 済み)。このファイルには秘密を書かない。
# =============================================================================

# ---- データベース (同じサーバー内の PostgreSQL 18) ----
# 形式: postgresql://<ユーザー>:<パスワード>@localhost:5432/<DB名>
#
# ⚠️ パスワードに記号 (! * $ # など) が含まれる場合は URL エンコードが必要:
#      !  -> %21     *  -> %2A     $  -> %24     #  -> %23     @  -> %40
#    エンコードしないと「# 以降がコメント扱い」「$ が変数展開」で接続できない。
#    この行は必ずシングルクォートで囲む (ダブルクォートだと $ が展開される)
DATABASE_URL='postgresql://ai_labo_dbuser:<URLエンコード済みパスワード>@localhost:5432/wearpos'
# 自己ホストでは接続プールを介さないため DIRECT_DATABASE_URL は不要 (DATABASE_URL が使われる)
# 1プロセスあたりの接続数。PM2 は 1 プロセスなのでこの値がそのまま上限になる
DATABASE_POOL_MAX="8"

# ---- ログイン (認証) ----
# 本番では必須。未設定だと起動時にエラーで止まる。
#   openssl rand -base64 32
AUTH_SECRET=""

# ---- アプリの公開 URL ----
# LINE に送るリンク (会員証・登録フォーム) や LIFF の遷移先に使う
APP_URL="https://wearpos.ai-labo.cloud"

# ---- LINE 自動リマインド (cron から /api/reminders/run を叩くときの認証) ----
#   openssl rand -base64 32
CRON_SECRET=""

# ---- POS 連携 API (外部 POS から取引を送る場合の共有シークレット) ----
# 使わない場合も、推測されない値を入れておく
#   openssl rand -base64 32
POS_API_KEY=""

# ---- LINE 公式アカウント連携 (Messaging API) ----
# 開発環境 (Vercel) と同じ値をそのまま移す。Webhook URL 側を新ドメインに変更すること
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_PUSH_ENABLED="true"

# ---- LIFF (リッチメニューからの直接遷移) ----
# LINE Developers 側の LIFF エンドポイント URL を https://wearpos.ai-labo.cloud/liff に変更すること
LIFF_ID=""
LIFF_CHANNEL_ID=""

# ---- AI考察 ----
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# OPENAI_MODEL=""

# ---- 本番では絶対に "1" にしない (ログインが無効になる) ----
# AUTH_DISABLED=""
