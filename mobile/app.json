{
  "expo": {
    "name": "wearPOS",
    "slug": "wearpos",
    "scheme": "wearpos",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cloud.ailabo.wearpos",
      "infoPlist": {
        "NSCameraUsageDescription": "商品の値札や会員証のバーコードを読み取るためにカメラを使用します。"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "cloud.ailabo.wearpos",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "appUrl": "https://wearpos.ai-labo.cloud"
    }
  }
}
